{
  "manifest_version": 3,
  "name": "FlowState Focus Chamber Companion",
  "version": "1.0.0",
  "description": "Chrome Extension companion bridge for FlowState Focus Chamber",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.yourdomain.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
